{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "speech-to-text-telegram",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "vars": {
    "DAILY_LIMIT": "20",
    "BOT_TOKEN": "",
    "GEMINI_API_KEY": ""
  },
  "kv_namespaces": [
    {
      "binding": "OWNER_STORE",
      "id": "placeholder"
    }
  ],
  "observability": {
    "enabled": true
  }
}